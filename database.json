      },
      {
        "type": "FeatureRow",
        "props": {
          "id": "FeatureRow-7",
          "title": "A smarter way to pay",
          "lead": "Send money to the merchants you love straight from your bank. It's more secure, it's quicker and there are no fees.",
          "cards": [
            {
              "type": "FeatureCard",
              "props": {
                "id": "FeatureCard-4",
                "image": "https://druo.com/wp-content/smush-webp/2025/01/Select-Bank.png.webp",
