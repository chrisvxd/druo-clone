      {
        "type": "CtaStrip",
        "props": {
          "id": "CtaStrip-20",
          "title": "Start paying from your bank account today",
          "actions": [
            {
              "type": "Button",
              "props": {
                "id": "Button-19",
                "label": "Connect Account",
                "href": "https://druo.com/en/get-started/",
                "variant": "primary",
                "wide": true
              }
            }
          ]
        }
      },
      {
        "type": "BusinessCard",
        "props": {
          "id": "BusinessCard-22",
          "eyebrow": "DRUO for businesses",
          "title": "Grow your business with DRUO",
          "text": "<p>Take payments straight from your customers' bank accounts to keep more of every sale and keep buyers happy.</p>",
          "actions": [
            {
              "type": "Button",
              "props": {
                "id": "Button-21",
                "label": "Get Started",
                "href": "https://druo.com/en/get-started/",
                "variant": "primary",
                "wide": true
              }
            }
          ],
          "image": "https://druo.com/wp-content/smush-webp/2025/01/Product-Suite-Image.png.webp",
          "imageAlt": "DRUO dashboard with integrations"
        }
      },
      {
        "type": "Faq",
        "props": {
          "id": "Faq-29",
          "title": "Frequently Asked Questions (FAQ)",
          "items": [
            {
              "type": "FaqItem",
              "props": {
                "id": "FaqItem-23",
                "question": "What is DRUO?",
                "answer": "<p>DRUO lets you pay businesses directly from your bank account, so you don't need a card or a payment app.</p>"
              }
            },
            {
              "type": "FaqItem",
              "props": {
                "id": "FaqItem-24",
                "question": "Can my business accept payments with DRUO?",
                "answer": "<p>Yes. See <a href=\"https://druo.com/en/sellers/\">DRUO for Business</a> to learn how.</p>"
              }
            },
            {
              "type": "FaqItem",
              "props": {
                "id": "FaqItem-25",
                "question": "Is my bank account safe with DRUO?",
                "answer": "<p>Yes. DRUO protects your account with encryption, step-by-step verification and around-the-clock monitoring for unusual activity.</p>"
              }
            },
            {
              "type": "FaqItem",
              "props": {
                "id": "FaqItem-26",
                "question": "Does it cost anything to pay with DRUO?",
                "answer": "<p>No. Paying with DRUO is free, and you won't pay the fees that come with cards.</p>"
              }
            },
            {
              "type": "FaqItem",
              "props": {
                "id": "FaqItem-27",
                "question": "Can I pay merchants in other countries?",
                "answer": "<p>Yes, as long as your bank is in the DRUO network.</p>"
              }
            },
            {
              "type": "FaqItem",
              "props": {
                "id": "FaqItem-28",
                "question": "How do I change or cancel a recurring payment?",
                "answer": "<p>Contact the merchant you set the payment up with first. If you still need help, <a href=\"https://druo.com/en/contact-us/\">get in touch with DRUO</a>.</p>"
              }
            }
          ]
        }
      }
    ]
