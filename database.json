      {
        "type": "SplitBand",
        "props": {
          "id": "SplitBand-13",
          "image": "https://druo.com/wp-content/uploads/2026/10/DRUO-Autopay.png",
          "imageAlt": "DRUO subscription set to autopay from savings",
          "title": "Pay the brands you love in seconds, or set it and forget it",
          "text": "<p>Use DRUO for bills, memberships and everything in between, either one payment at a time or on a schedule. Link your bank once and the next payment goes out on its own.</p>",
          "actions": [
            {
              "type": "Button",
              "props": {
                "id": "Button-11",
