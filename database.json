                "imageAlt": "Tokenized DRUO payment card",
                "title": "Protected by design",
                "text": "Modern fraud protection makes paying with DRUO 50x safer than paying with a card."
              }
            },
            {
              "type": "FeatureCard",
              "props": {
                "id": "FeatureCard-6",
